# Copy to deploy/.env and adjust. Never commit real keys.

# --- Relay -----------------------------------------------------------------
# Public DNS name for TLS (Caddy). "localhost" uses Caddy's internal CA.
RELAY_DOMAIN=localhost
# Stable public relay id clients can display (optional).
HC_PUSH_RELAY_ID=my-holoport-relay
# key | open. Key mode: give each client (or app) a registration key.
HC_PUSH_REGISTRATION=key
# >= 16 chars each, comma separated. Prefer HC_PUSH_REGISTRATION_KEYS_FILE.
HC_PUSH_REGISTRATION_KEYS=change-me-to-a-long-random-string
HC_PUSH_RETENTION_MAX_EVENTS=100000
HC_PUSH_RETENTION_MAX_AGE_SECS=604800
HC_PUSH_RATE_LIMIT_PER_MINUTE=120
RUST_LOG=info

# --- Holochain / EdgeNode (profile "edgenode") -------------------------------
EDGENODE_IMAGE=ghcr.io/holo-host/edgenode:latest
# Installed app id on the EdgeNode to observe (installed with happ_tool).
HC_PUSH_HC_APP_ID=my-happ

# --- Mock relays (profile "mock") ---------------------------------------------
MOCK_SPACE=uhC0kDemoSpaceDemoSpaceDemoSpaceDemoSpaceDemoSpaceDem

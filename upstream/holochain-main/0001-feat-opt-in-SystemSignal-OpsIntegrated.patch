+/// Held by an app connection that opted in to `SystemSignal::OpsIntegrated`.
+/// Dropping it (when the connection's tasks end) removes the subscription.
+#[derive(Debug)]
+pub struct OpsIntegratedSubscription(Arc<AtomicUsize>);
+
+impl Drop for OpsIntegratedSubscription {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::Relaxed);
+    }
 }
 
 impl AppBroadcast {
     pub(crate) fn new() -> Self {
         Self {
             channels: Arc::new(parking_lot::Mutex::new(HashMap::new())),
+            ops_integrated_subscribers: Arc::new(AtomicUsize::new(0)),
+            ops_integrated_queue: Arc::new(OnceLock::new()),
+            ops_integrated_dropped: Arc::new(AtomicU64::new(0)),
         }
     }
 
+    /// Queue an integration batch for `OpsIntegrated` delivery.
+    ///
+    /// Never blocks. Batches are delivered one at a time, in the order they
+    /// were queued, by a single task started on first use with `resolve`.
+    /// If the queue is full the batch is dropped and counted; clients
+    /// reconcile with `DumpOpTimings`. Returns whether the batch was queued.
+    pub(crate) fn queue_ops_integrated(
+        &self,
+        job: OpsIntegratedJob,
+        resolve: impl FnOnce() -> ResolveApps,
+    ) -> bool {
+        let tx = self.ops_integrated_queue.get_or_init(|| {
+            spawn_ops_integrated_delivery(self.clone(), resolve(), OPS_INTEGRATED_QUEUE_SIZE)
+        });
+        match tx.try_send(job) {
+            Ok(()) => true,
+            Err(_) => {
+                let n = self.ops_integrated_dropped.fetch_add(1, Ordering::Relaxed) + 1;
+                tracing::warn!(
+                    dropped_total = n,
+                    "OpsIntegrated delivery queue full; dropping a batch (reconcile with DumpOpTimings)"
+                );
+                false
+            }
+        }
+    }
+
+    /// Register an app connection as an `OpsIntegrated` subscriber.
+    pub(crate) fn subscribe_ops_integrated(&self) -> OpsIntegratedSubscription {
+        self.ops_integrated_subscribers
+            .fetch_add(1, Ordering::Relaxed);
+        OpsIntegratedSubscription(self.ops_integrated_subscribers.clone())
+    }
+
+    /// Whether any app connection currently wants `OpsIntegrated` signals. Lets the
+    /// integration workflow skip building them entirely when nobody listens.
+    pub(crate) fn has_ops_integrated_subscribers(&self) -> bool {
+        self.ops_integrated_subscribers.load(Ordering::Relaxed) > 0
+    }

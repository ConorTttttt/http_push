+/// Start the single task that turns queued batches into `OpsIntegrated`
+/// signals, preserving queue order and splitting large batches.
+fn spawn_ops_integrated_delivery(
+    broadcast: AppBroadcast,
+    resolve: ResolveApps,
+    capacity: usize,
+) -> mpsc::Sender<OpsIntegratedJob> {
+    let (tx, mut rx) = mpsc::channel::<OpsIntegratedJob>(capacity);
+    tokio::spawn(async move {
+        while let Some(job) = rx.recv().await {
+            let apps = resolve(job.dna_hash.clone()).await;
+            for chunk in job.ops.chunks(OPS_INTEGRATED_MAX_OPS_PER_SIGNAL) {
+                let signal = Signal::System(SystemSignal::OpsIntegrated {
+                    dna_hash: job.dna_hash.clone(),
+                    when_integrated: job.when_integrated,
+                    ops: chunk.to_vec(),
+                });
+                for app in &apps {
+                    // Err only means nobody is subscribed to this app right now.
+                    let _ = broadcast
+                        .create_send_handle(app.clone())
+                        .send(signal.clone());
+                }
+            }
+        }
+    });
+    tx
+}

+/// Notified after DHT ops are committed as integrated: by the integration
+/// workflow, and by source-chain flushes that write self-authored ops as
+/// integrated. Implementations must return quickly and never block.
+pub trait IntegratedOpsObserver: Send + Sync {
+    /// Cheap check; when it returns false, no notification is built.
+    fn is_active(&self) -> bool;
+    /// Called after the commit, outside any database transaction.
+    fn ops_integrated(

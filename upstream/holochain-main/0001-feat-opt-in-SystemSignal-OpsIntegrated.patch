 /// Methods related to management of Conductor state
 mod state_impls {
     use super::*;
 
     impl Conductor {
+        /// Whether any app connection opted in to `SystemSignal::OpsIntegrated`.
+        pub(crate) fn wants_ops_integrated(&self) -> bool {
+            self.app_broadcast.has_ops_integrated_subscribers()
+        }
+
+        /// Send `SystemSignal::OpsIntegrated` to every enabled app with a cell of
+        /// `dna_hash`. Never blocks the caller: the target apps are resolved on a spawned
+        /// task and signals use the non-blocking per-app broadcast channels, which drop
+        /// signals for lagging connections. Only opted-in connections forward them.
+        pub(crate) fn notify_ops_integrated(
+            self: &Arc<Self>,
+            dna_hash: DnaHash,
+            when_integrated: Timestamp,
+            ops: Vec<holochain_types::signal::IntegratedOp>,
+        ) {
+            if ops.is_empty() || !self.wants_ops_integrated() {
+                return;
+            }
+            let weak = Arc::downgrade(self);
+            self.app_broadcast.queue_ops_integrated(
+                app_broadcast::OpsIntegratedJob {
+                    dna_hash,
+                    when_integrated,
+                    ops,
+                },
+                move || {
+                    Arc::new(move |dna: DnaHash| {
+                        let weak = weak.clone();
+                        Box::pin(async move {
+                            match weak.upgrade() {
+                                Some(c) => c.enabled_apps_with_dna(&dna).await,
+                                None => Vec::new(),
+                            }
+                        }) as futures::future::BoxFuture<'static, Vec<InstalledAppId>>
+                    })
+                },
+            );
+        }
+
+        /// Installed ids of enabled apps that have a cell of `dna_hash`.
+        async fn enabled_apps_with_dna(&self, dna_hash: &DnaHash) -> Vec<InstalledAppId> {
+            match self.get_state().await {
+                Ok(state) => state
+                    .enabled_apps()
+                    .filter(|(_, app)| app.all_cells().any(|c| c.dna_hash() == dna_hash))
+                    .map(|(id, _)| id.clone())
+                    .collect(),
+                Err(err) => {
+                    tracing::warn!(?err, "OpsIntegrated: could not read conductor state");
+                    Vec::new()
+                }
+            }
+        }

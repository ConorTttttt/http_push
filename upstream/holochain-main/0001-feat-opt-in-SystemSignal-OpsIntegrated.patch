+    /// Resolver whose first call is slow, so a naive task-per-batch delivery
+    /// would reorder the first two batches.
+    fn slow_first_resolver(app: InstalledAppId) -> ResolveApps {
+        let calls = Arc::new(AtomicUsize::new(0));
+        Arc::new(move |_dna| {
+            let app = app.clone();
+            let first = calls.fetch_add(1, Ordering::SeqCst) == 0;
+            Box::pin(async move {
+                if first {
+                    tokio::time::sleep(std::time::Duration::from_millis(100)).await;
+                }
+                vec![app]
+            })
+        })
+    }
+
+    #[tokio::test]
+    async fn ops_integrated_batches_are_delivered_in_order() {
+        let broadcast = AppBroadcast::new();
+        let app: InstalledAppId = "app".into();
+        let dna = fixt!(DnaHash);
+        let mut rx = broadcast.subscribe(app.clone());
+        let (first, second) = (ops(1), ops(1));
+        assert!(
+            broadcast.queue_ops_integrated(job(&dna, first.clone()), || {
+                slow_first_resolver(app.clone())
+            })
+        );
+        assert!(broadcast.queue_ops_integrated(job(&dna, second.clone()), || unreachable!()));
+        assert_eq!(integrated(rx.recv().await.unwrap()), first);
+        assert_eq!(integrated(rx.recv().await.unwrap()), second);
+    }
+

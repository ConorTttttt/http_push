+        let broadcast = AppBroadcast::new();
+        let dna = fixt!(DnaHash);
+        // A resolver that never completes keeps the delivery task busy with
+        // the first batch, so the queue (capacity 1) fills up.
+        let never: ResolveApps = Arc::new(|_| Box::pin(std::future::pending()));
+        let tx = spawn_ops_integrated_delivery(broadcast.clone(), never, 1);
+        broadcast.ops_integrated_queue.set(tx).unwrap();
+        assert!(broadcast.queue_ops_integrated(job(&dna, ops(1)), || unreachable!()));
+        tokio::time::sleep(std::time::Duration::from_millis(20)).await; // task takes it
+        assert!(broadcast.queue_ops_integrated(job(&dna, ops(1)), || unreachable!()));
+        let started = std::time::Instant::now();
+        assert!(!broadcast.queue_ops_integrated(job(&dna, ops(1)), || unreachable!()));
+        assert!(
+            started.elapsed() < std::time::Duration::from_millis(50),
+            "must not block"
+        );
+        assert_eq!(broadcast.ops_integrated_dropped(), 1);
+    }

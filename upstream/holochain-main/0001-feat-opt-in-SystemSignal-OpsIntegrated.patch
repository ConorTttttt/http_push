+/// Records `OpsIntegrated` notifications for the observer tests.
+#[derive(Default)]
+struct RecordingObserver {
+    active: std::sync::atomic::AtomicBool,
+    seen: std::sync::Mutex<Vec<(Timestamp, Vec<holochain_types::signal::IntegratedOp>)>>,
+}
+
+impl IntegratedOpsObserver for RecordingObserver {
+    fn is_active(&self) -> bool {
+        self.active.load(std::sync::atomic::Ordering::SeqCst)
+    }
+    fn ops_integrated(&self, when: Timestamp, ops: Vec<holochain_types::signal::IntegratedOp>) {
+        self.seen.lock().unwrap().push((when, ops));
+    }
+}
+
+#[tokio::test]
+async fn integrate_ready_ops_notifies_observer_through_clones() {
+    let store = DhtStore::new_test(dht_id()).await.unwrap();
+    let observer = Arc::new(RecordingObserver::default());
+    // Installed on the original, used through a clone (as workflows do).
+    assert!(store.set_integrated_ops_observer(observer.clone()));
+    assert!(
+        !store.set_integrated_ops_observer(observer.clone()),
+        "set once"
+    );
+    let clone = store.clone();
+
+    let ready = |n: u8| {
+        let op = build_test_store_record_op_hashed(n.into());
+        let clone = clone.clone();
+        async move {
+            clone.record_incoming_ops(vec![op.clone()]).await.unwrap();
+            clone
+                .record_chain_op_sys_validation_outcomes(vec![(
+                    op.0.as_hash().clone(),
+                    SysOutcome::Accepted,
+                )])
+                .await
+                .unwrap();
+            clone
+                .record_app_validation_outcomes(vec![(
+                    op.0.as_hash().clone(),
+                    AppOutcome::Accepted,
+                )])
+                .await
+                .unwrap();
+            op
+        }
+    };
+
+    // Inactive observer: nothing is built or delivered.
+    ready(60).await;
+    clone
+        .integrate_ready_ops(Timestamp::from_micros(1))
+        .await
+        .unwrap();
+    assert!(observer.seen.lock().unwrap().is_empty());
+
+    // Active observer: notified after commit with hash, basis and validity.
+    observer
+        .active
+        .store(true, std::sync::atomic::Ordering::SeqCst);
+    let op = ready(61).await;
+    clone
+        .integrate_ready_ops(Timestamp::from_micros(2))
+        .await
+        .unwrap();
+    let seen = observer.seen.lock().unwrap();
+    assert_eq!(seen.len(), 1);
+    assert_eq!(seen[0].0, Timestamp::from_micros(2));
+    assert_eq!(seen[0].1.len(), 1);
+    assert_eq!(&seen[0].1[0].op_hash, op.0.as_hash());
+    assert_eq!(seen[0].1[0].validity, OpValidity::Accepted);
+}

+        /// Start the next gossip round in one of an app's DNAs with a known peer.
+        /// See [`AppRequest::RequestGossipRound`](holochain_conductor_api::AppRequest::RequestGossipRound).
+        pub async fn request_gossip_round_for_app(
+            &self,
+            installed_app_id: &InstalledAppId,
+            dna_hash: DnaHash,
+            url: kitsune2_api::Url,
+        ) -> ConductorApiResult<()> {
+            let state = self.get_state().await?;
+            let app = state.get_app(installed_app_id)?;
+            if !app.all_cells().any(|c| *c.dna_hash() == dna_hash) {
+                return Err(ConductorApiError::Other("DNA hash not found in app".into()));
+            }
+            self.holochain_p2p
+                .request_gossip_round(dna_hash, url)
+                .await?;
+            Ok(())
+        }

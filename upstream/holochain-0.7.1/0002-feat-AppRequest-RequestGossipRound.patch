+    fn request_gossip_round(
+        &self,
+        dna_hash: DnaHash,
+        url: kitsune2_api::Url,
+    ) -> BoxFut<'_, HolochainP2pResult<()>> {
+        Box::pin(async move {
+            let space_id = dna_hash.to_k2_space();
+            let space = self
+                .kitsune
+                .space_if_exists(space_id.clone())
+                .await
+                .ok_or(HolochainP2pError::K2SpaceNotFound(space_id))?;
+            space.gossip().request_round(url).await?;
+            Ok(())
+        })
+    }

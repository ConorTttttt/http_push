@@ -0,0 +1,108 @@
+use crate::sweettest::*;
+use crate::test_utils::inline_zomes::simple_crud_zome;
+use holo_hash::{ActionHash, DhtOpHash, DnaHash};
+use holochain_types::prelude::InstalledAppId;
+use kitsune2_api::Url;
+use std::collections::HashSet;
+use std::time::Duration;
+
+/// Hashes of the ops `conductor` has integrated for `dna`.
+async fn integrated_ops(conductor: &SweetConductor, dna: &DnaHash) -> HashSet<DhtOpHash> {
+    conductor
+        .dump_op_timings(dna, None, Some(10_000))
+        .await
+        .unwrap()
+        .timings
+        .into_iter()
+        .filter(|t| t.when_integrated.is_some())
+        .map(|t| t.op_hash)
+        .collect()
+}
+
+/// A requested gossip round moves data between two peers long before the
+/// scheduled one would. Publishing is off and the scheduled initiate
+/// interval is a minute, so without the request nothing is exchanged during
+/// the test.
+#[tokio::test(flavor = "multi_thread")]
+async fn requested_gossip_round_syncs_before_the_schedule() {
+    holochain_trace::test_run();
+
+    let config = SweetConductorConfig::rendezvous(false).tune_network_config(|nc| {
+        *nc = std::mem::take(nc)
+            .with_gossip_initiate_interval_ms(60_000)
+            .with_gossip_min_initiate_interval_ms(60_000);
+        nc.disable_publish = true;
+    });
+    let mut conductors = SweetConductorBatch::from_config_rendezvous(2, config).await;
+    let (dna, _, _) = SweetDnaFile::unique_from_inline_zomes(simple_crud_zome()).await;
+    let dna_hash = dna.dna_hash().clone();
+    let app_id: InstalledAppId = "app".into();
+    let apps = conductors
+        .setup_app(&app_id, std::slice::from_ref(&dna))
+        .await
+        .unwrap();
+    let ((alice,), (bob,)) = apps.into_tuples();
+    for c in conductors.iter() {
+        c.declare_full_storage_arcs(&dna_hash).await;
+    }
+    conductors.exchange_peer_info().await;
+
+    let _: ActionHash = conductors[0]
+        .call(
+            &alice.zome(SweetInlineZomes::COORDINATOR),
+            "create_string",
+            "hi".to_string(),
+        )
+        .await;
+    let alice_ops = integrated_ops(&conductors[0], &dna_hash).await;
+
+    // Control: nothing reaches Bob on its own within a few seconds.
+    tokio::time::sleep(Duration::from_secs(3)).await;
+    assert!(!alice_ops.is_subset(&integrated_ops(&conductors[1], &dna_hash).await));
+
+    // Requests are refused for a DNA outside the app, for a peer that is not
+    // a live entry in Bob's peer store, and for Bob's own agent.
+    let other_dna = DnaHash::from_raw_32(vec![1; 32]);
+    let unknown = Url::from_str("ws://unknown.test:80/peer").unwrap();
+    // Each conductor's peer store holds both agents; pick by agent key.
+    let url_of = |agent: kitsune2_api::AgentId| {
+        let infos = conductors[1].get_agent_infos(Some(vec![dna_hash.clone()]));
+        async move {
+            infos
+                .await
+                .unwrap()
+                .into_iter()
+                .find(|info| info.agent == agent)
+                .and_then(|info| info.url.clone())
+                .expect("agent has a url")
+        }
+    };
+    let alice_url = url_of(alice.agent_pubkey().to_k2_agent()).await;
+    let bob_url = url_of(bob.agent_pubkey().to_k2_agent()).await;
+    assert!(conductors[1]
+        .request_gossip_round_for_app(&app_id, other_dna, alice_url.clone())
+        .await
+        .is_err());
+    assert!(conductors[1]
+        .request_gossip_round_for_app(&app_id, dna_hash.clone(), unknown)
+        .await
+        .is_err());
+    assert!(conductors[1]
+        .request_gossip_round_for_app(&app_id, dna_hash.clone(), bob_url)
+        .await
+        .is_err());
+
+    let requested = std::time::Instant::now();
+    conductors[1]
+        .request_gossip_round_for_app(&app_id, dna_hash.clone(), alice_url)
+        .await
+        .unwrap();
+    tokio::time::timeout(Duration::from_secs(15), async {
+        while !alice_ops.is_subset(&integrated_ops(&conductors[1], &dna_hash).await) {
+            tokio::time::sleep(Duration::from_millis(100)).await;
+        }
+    })
+    .await
+    .expect("Bob integrated Alice's ops after the requested round");
+    println!("synced {:?} after the request", requested.elapsed());
+}

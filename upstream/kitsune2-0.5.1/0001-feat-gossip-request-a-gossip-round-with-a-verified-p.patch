+    }
+
+    #[tokio::test]
+    async fn requested_round_syncs_without_waiting_for_the_schedule() {
+        enable_tracing();
+        // Ordinary initiation is slowed down so far that it cannot explain a
+        // sync within the test's time limit.
+        let slow = K2GossipConfig {
+            initiate_interval_ms: 60_000,
+            initial_initiate_interval_ms: 60_000,
+            min_initiate_interval_ms: 10,
+            initiate_jitter_ms: 0,
+            ..Default::default()
+        };
+        let factory = K2GossipFunctionalTestFactory::create(
+            TEST_SPACE_ID,
+            false,
+            Some(slow),
+        )
+        .await;
+
+        let make = |n: u8, t: i64| {
+            let op = MemoryOp::new(Timestamp::from_micros(t), vec![n; 128]);
+            (op.compute_op_id(), op)
+        };
+
+        let harness_1 = factory.new_instance().await;
+        harness_1.join_local_agent(DhtArc::FULL).await;
+        let harness_2 = factory.new_instance().await;
+        let agent_info_2 = harness_2.join_local_agent(DhtArc::FULL).await;
+        let harness_3 = factory.new_instance().await;
+        harness_3.join_local_agent(DhtArc::FULL).await;
+        let (op_id, op) = make(7, 100);
+        harness_2
+            .space
+            .op_store()
+            .process_incoming_ops(vec![op.clone().into()])
+            .await
+            .unwrap();
+
+        // Both 1 and 3 learn about 2; only 1 requests a round.
+        for h in [&harness_1, &harness_3] {
+            h.space
+                .peer_store()
+                .insert(vec![agent_info_2.clone()])
+                .await
+                .unwrap();
+        }
+        harness_1
+            .gossip
+            .request_round(agent_info_2.url.clone().unwrap())
+            .await
+            .unwrap();
+
+        let started = std::time::Instant::now();
+        loop {
+            let got = harness_1
+                .space
+                .op_store()
+                .retrieve_ops(vec![op_id.clone()])
+                .await
+                .unwrap();
+            if got.len() == 1 {
+                break;
+            }
+            assert!(
+                started.elapsed() < std::time::Duration::from_secs(10),
+                "requested round should sync within 10 s"
+            );
+            tokio::time::sleep(std::time::Duration::from_millis(20)).await;
+        }
+
+        // Control: without a request, 3 has not synced (its next round is a
+        // minute away).
+        assert!(
+            harness_3
+                .space
+                .op_store()
+                .retrieve_ops(vec![op_id])
+                .await
+                .unwrap()
+                .is_empty()
+        );
+        let _ = op;
+    }

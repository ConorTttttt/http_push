diff --git a/crates/api/src/gossip.rs b/crates/api/src/gossip.rs
index de9cf8f..e808f06 100644
--- a/crates/api/src/gossip.rs
+++ b/crates/api/src/gossip.rs
@@ -32,6 +32,24 @@ pub trait Gossip: 'static + Send + Sync + std::fmt::Debug {
         &self,
         request: GossipStateSummaryRequest,
     ) -> BoxFut<'_, K2Result<GossipStateSummary>>;
+
+    /// Ask the gossip module to initiate its next round with `peer`.
+    ///
+    /// `peer` must be the URL of a live agent in the peer store, i.e. one
+    /// whose signed agent info was verified when it was inserted. Requests
+    /// for unknown, expired or tombstoned peers are rejected. The request
+    /// only changes which peer is chosen next; the responder applies its
+    /// usual rate limits and ordinary target selection resumes afterwards.
+    ///
+    /// The default implementation reports that this is unsupported.
+    fn request_round(&self, peer: Url) -> BoxFut<'_, K2Result<()>> {
+        let _ = peer;
+        Box::pin(async move {
+            Err(crate::K2Error::other(
+                "this gossip module does not support requested rounds",
+            ))
+        })
+    }
 }
 

+    #[tokio::test]
+    async fn request_round_rejects_unknown_peer() {
+        enable_tracing();
+        let factory =
+            K2GossipFunctionalTestFactory::create(TEST_SPACE_ID, false, None)
+                .await;
+        let harness = factory.new_instance().await;
+        harness.join_local_agent(DhtArc::FULL).await;
+        let unknown = Url::from_str("ws://127.0.0.1:1/not-a-peer").unwrap();
+        assert!(harness.gossip.request_round(unknown).await.is_err());
+        // Its own agent is in its peer store, but is not a gossip partner.
+        let own = harness.space.current_url().expect("bound");
+        assert!(
+            harness
+                .space
+                .peer_store()
+                .get_all()
+                .await
+                .unwrap()
+                .iter()
+                .any(|a| a.url.as_ref() == Some(&own))

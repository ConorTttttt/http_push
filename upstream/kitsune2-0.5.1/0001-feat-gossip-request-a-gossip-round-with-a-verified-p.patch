+
+    fn request_round(&self, peer: Url) -> BoxFut<'_, K2Result<()>> {
+        Box::pin(async move {
+            // Only peers whose signed agent info is in the peer store (and was
+            // therefore verified on insert) may be requested.
+            let now = Timestamp::now();
+            let live: Vec<_> = self
+                .peer_store
+                .get_all()
+                .await?
+                .into_iter()
+                .filter(|a| {
+                    a.url.as_ref() == Some(&peer)
+                        && !a.is_tombstone
+                        && a.expires_at > now
+                })
+                .collect();
+            if live.is_empty() {
+                return Err(K2Error::other(
+                    "requested gossip peer is not a live agent in the peer store",
+                ));
+            }
+            // The peer store also holds this node's own agents.
+            let local = self.local_agent_store.get_all().await?;
+            if live
+                .iter()
+                .any(|a| local.iter().any(|l| l.agent() == &a.agent))
+            {
+                return Err(K2Error::other(
+                    "requested gossip peer is one of this node's own agents",
+                ));
+            }
+            self.requested_rounds.push(peer.clone());
+            tracing::info!(%peer, "Gossip round requested");
+            if let Some(tx) = self.force_initiate.get() {
+                let _ = tx.try_send(());
+            }
+            Ok(())
+        })
+    }
+}
+
+/// How often a requested peer is tried before ordinary selection resumes.
+pub(crate) const MAX_REQUESTED_ROUND_ATTEMPTS: u32 = 10;
+
+/// Queue of peers that an application asked to gossip with next.
+#[derive(Debug, Clone, Default)]
+pub(crate) struct RequestedRounds(
+    Arc<std::sync::Mutex<std::collections::VecDeque<(Url, u32)>>>,
+);
+
+impl RequestedRounds {
+    fn lock(
+        &self,
+    ) -> std::sync::MutexGuard<'_, std::collections::VecDeque<(Url, u32)>> {
+        self.0.lock().unwrap_or_else(|e| e.into_inner())
+    }
+
+    /// Queue `peer` once; a repeated request resets its attempt count.
+    pub(crate) fn push(&self, peer: Url) {
+        let mut q = self.lock();
+        if let Some(entry) = q.iter_mut().find(|(u, _)| *u == peer) {
+            entry.1 = 0;
+        } else {
+            q.push_back((peer, 0));
+        }
+    }
+
+    /// The peer to try next, if any.
+    pub(crate) fn next(&self) -> Option<Url> {
+        self.lock().front().map(|(u, _)| u.clone())
+    }
+
+    /// A round with `peer` was initiated: forget the request.
+    pub(crate) fn done(&self, peer: &Url) {
+        self.lock().retain(|(u, _)| u != peer);
+    }
+
+    /// Initiation with `peer` failed. Keep it for another try unless it
+    /// reached [MAX_REQUESTED_ROUND_ATTEMPTS]. Returns whether it is kept.
+    pub(crate) fn failed(&self, peer: &Url) -> bool {
+        let mut q = self.lock();
+        let mut kept = true;
+        q.retain_mut(|(u, attempts)| {
+            if u != peer {
+                return true;
+            }
+            *attempts += 1;
+            kept = *attempts < MAX_REQUESTED_ROUND_ATTEMPTS;
+            kept
+        });
+        kept
+    }
+}
+
+#[cfg(test)]
+mod requested_rounds_tests {
+    use super::*;
+
+    fn url(n: u16) -> Url {
+        Url::from_str(format!("ws://127.0.0.1:{n}")).unwrap()
+    }
+
+    #[test]
+    fn fifo_dedup_and_bounded_retries() {
+        let q = RequestedRounds::default();
+        assert_eq!(q.next(), None);
+        q.push(url(1));
+        q.push(url(2));
+        q.push(url(1)); // duplicate: not queued twice
+        assert_eq!(q.next(), Some(url(1)));
+        for _ in 0..MAX_REQUESTED_ROUND_ATTEMPTS - 1 {
+            assert!(q.failed(&url(1)));
+        }
+        assert!(!q.failed(&url(1)), "dropped after the attempt budget");
+        assert_eq!(q.next(), Some(url(2)));
+        q.done(&url(2));
+        assert_eq!(q.next(), None);
+    }
+
+    #[test]
+    fn repeated_request_resets_attempts() {
+        let q = RequestedRounds::default();
+        q.push(url(1));
+        for _ in 0..MAX_REQUESTED_ROUND_ATTEMPTS - 1 {
+            q.failed(&url(1));
+        }
+        q.push(url(1));
+        assert!(q.failed(&url(1)), "budget restarted");
+    }
 }
 

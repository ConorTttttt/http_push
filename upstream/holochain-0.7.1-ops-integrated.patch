+        /// Send `SystemSignal::OpsIntegrated` to every enabled app with a cell of
+        /// `dna_hash`. Never blocks the caller: the target apps are resolved on a spawned
+        /// task and signals use the non-blocking per-app broadcast channels, which drop
+        /// signals for lagging connections. Only opted-in connections forward them.
+        pub(crate) fn notify_ops_integrated(
+            self: &Arc<Self>,
+            dna_hash: DnaHash,
+            when_integrated: Timestamp,
+            ops: Vec<holochain_types::signal::IntegratedOp>,
+        ) {
+            use holochain_types::signal::OPS_INTEGRATED_MAX_OPS_PER_SIGNAL;
+            if ops.is_empty() || !self.wants_ops_integrated() {
+                return;
+            }
+            let conductor = self.clone();
+            tokio::spawn(async move {
+                let state = match conductor.get_state().await {
+                    Ok(s) => s,
+                    Err(err) => {
+                        tracing::warn!(?err, "OpsIntegrated: could not read conductor state");
+                        return;
+                    }
+                };

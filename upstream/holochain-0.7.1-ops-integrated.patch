+/// Delivers integrated-op notifications from a DNA's `DhtStore` as
+/// `SystemSignal::OpsIntegrated`. Holds a weak handle: the conductor owns the
+/// spaces that own the store.
+pub(crate) struct OpsIntegratedObserver {
+    conductor: std::sync::Weak<Conductor>,
+    dna_hash: DnaHash,
+}
+
+impl OpsIntegratedObserver {
+    pub(crate) fn new(conductor: &ConductorHandle, dna_hash: DnaHash) -> Self {
+        Self {
+            conductor: Arc::downgrade(conductor),
+            dna_hash,
+        }
+    }
+}
+
+impl holochain_state::dht_store::IntegratedOpsObserver for OpsIntegratedObserver {
+    fn is_active(&self) -> bool {
+        self.conductor
+            .upgrade()
+            .is_some_and(|c| c.wants_ops_integrated())
+    }
+
+    fn ops_integrated(
+        &self,
+        when_integrated: Timestamp,
+        ops: Vec<holochain_types::signal::IntegratedOp>,
+    ) {
+        if let Some(c) = self.conductor.upgrade() {
+            c.notify_ops_integrated(self.dna_hash.clone(), when_integrated, ops);
+        }
+    }
+}
